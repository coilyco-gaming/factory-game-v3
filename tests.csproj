<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="ReportGenerator" Version="5.4.4" />
  </ItemGroup>

  <!-- !!! IMPORTANT !!! -->
  <!-- !!! THESE VERSIONS MUST BE KEPT IN SYNC -->
  <!-- !!! WITH THE DOWNLOADED DLLS INSIDE OF THE PLUGIN FOLDER -->
  <!-- !!! FAILURE TO DO THIS WILL RESULT IN UNDEFINED BEHAVIOR -->
  <!-- !!! IMPORTANT !!! -->
  <ItemGroup>
    <PackageReference Include="RoyT.AStar" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Library\**" />
    <Compile Remove="Library\**" />
    <EmbeddedResource Remove="Library\**" />
    <None Remove="Library\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Temp\**" />
    <Compile Remove="Temp\**" />
    <EmbeddedResource Remove="Temp\**" />
    <None Remove="Temp\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Packages\**" />
    <Compile Remove="Packages\**" />
    <EmbeddedResource Remove="Packages\**" />
    <None Remove="Packages\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\PluginMaster\**" />
    <Compile Remove="Assets\PluginMaster\**" />
    <EmbeddedResource Remove="Assets\PluginMaster\**" />
    <None Remove="Assets\PluginMaster\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\Scripts\FactoryGameController.cs" />
    <Compile Remove="Assets\Scripts\FactoryGameController.cs" />
    <EmbeddedResource Remove="Assets\Scripts\FactoryGameController.cs" />
    <None Remove="Assets\Scripts\FactoryGameController.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\Scripts\WorldObjects\FactoryGame\**" />
    <Compile Remove="Assets\Scripts\WorldObjects\FactoryGame\**" />
    <EmbeddedResource Remove="Assets\Scripts\WorldObjects\FactoryGame\**" />
    <None Remove="Assets\Scripts\WorldObjects\FactoryGame\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Xunit.Core">
      <HintPath>Assets\Plugins\xunit.core.dll</HintPath>
    </Reference>
    <Reference Include="Xunit.Assert">
      <HintPath>Assets\Plugins\xunit.assert.dll</HintPath>
    </Reference>
    <Reference Include="Xunit.Abstractions">
      <HintPath>Assets\Plugins\xunit.abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Xunit.Execution.DotNet">
      <HintPath>Assets\Plugins\xunit.execution.dotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
